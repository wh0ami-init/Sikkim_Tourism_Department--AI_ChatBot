# MySQL connection
MYSQL_HOST = localhost
MYSQL_PORT = 3306
MYSQL_USER = root
MYSQL_PASSWORD =
MYSQL_DATABASE = sikkim_tourism
MYSQL_SSL_CA = certs/ca.pem

# Gemini
GEMINI_API_KEY =
GEMINI_MODEL = gemini-3.6-flash
GEMINI_EMBEDDING_MODEL = models/gemini-embedding-001

# Groq
GROQ_API_KEY =
GROQ_MODEL = openai/gpt-oss-120b
GROQ_FALLBACK_MODEL = openai/gpt-oss-20b
ENABLE_PROMPT_GUARD = false
PROMPT_GUARD_MODEL = meta-llama/llama-prompt-guard-2-86m

# Optional services
TAVILY_API_KEY =
ENABLE_FOLLOWUPS = true
ENABLE_CIRCULAR_SCRAPER = false

CIRCULARS_ALLOWED_HOST = sikkimtourism.gov.in
CIRCULARS_NOTICE_URL = https://sikkimtourism.gov.in/updates/notice
CIRCULARS_TENDER_URL = https://sikkimtourism.gov.in/updates/tender
CIRCULARS_SYNC_INTERVAL_MINUTES = 45
CIRCULARS_MAX_PDF_BYTES = 15728640
CIRCULARS_MAX_PER_RUN = 20

MAX_ADMIN_UPLOAD_REQUEST_BYTES = 16777216
MAX_CHAT_REQUEST_BYTES = 6291456

# Qdrant vector store
QDRANT_URL =
QDRANT_API_KEY =
QDRANT_COLLECTION = sikkim_destinations

# Admin authentication
# Generate a bootstrap key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY =

# CORS
ALLOWED_ORIGINS = http://localhost:5173
ALLOWED_METHODS = GET, POST, PUT, DELETE, OPTIONS
ALLOWED_HEADERS = Content-Type,Authorization,X-Admin-Key,X-Conversation-Token

# Runtime environment
ENVIRONMENT = development
